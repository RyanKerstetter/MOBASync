{
  "name": "2d-moba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @2d-moba/client",
    "dev:server": "npm run dev --workspace @2d-moba/server",
    "build": "npm run build --workspace @2d-moba/client && npm run typecheck --workspace @2d-moba/server",
    "preview": "npm run preview --workspace @2d-moba/client"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0"
  },
  "allowScripts": {
    "node-datachannel@0.32.1": true
  }
}
